# Pruebas manuales con la extensión REST Client (VS Code) o desde Visual Studio / Rider.
# Requiere haber corrido deploy/datos-desarrollo.sql.
@api = http://localhost:5080
@empresa = 0192f000-0000-7000-8000-000000000001
@usuario = admision.local

POST {{api}}/api/v1/pacientes
Content-Type: application/json
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: {{usuario}}

{
  "apellidos": "Pérez",
  "nombres": "Ana María",
  "fechaNacimiento": "1985-04-12",
  "sexoRegistral": "F",
  "telefono": "+54 11 5555-0000",
  "identificadores": [{ "sistema": "DNI", "valor": "31555222" }]
}

###
GET {{api}}/api/v1/pacientes?documento=31555222
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: {{usuario}}

### Horarios libres de la agenda de ejemplo (lunes y miércoles 9 a 12)
GET {{api}}/api/v1/turnos/disponibilidad?profesionalId=0192f000-0000-7000-8000-0000000000b6&desde=2026-11-02&hasta=2026-11-06
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: {{usuario}}

### Dar un turno (reemplazar pacienteId por el id devuelto al crear el paciente)
POST {{api}}/api/v1/turnos
Content-Type: application/json
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: {{usuario}}

{
  "agendaId": "0192f000-0000-7000-8000-0000000000c1",
  "pacienteId": "00000000-0000-0000-0000-000000000000",
  "inicio": "2026-11-02T09:20:00-03:00"
}

### RRHH: documentación vencida o por vencer en 30 días (usuario rrhh.local)
GET {{api}}/api/v1/rrhh/vencimientos?dias=30
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: rrhh.local

### RRHH: buscar legajos
GET {{api}}/api/v1/rrhh/empleados?texto=Persona
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: rrhh.local

### RRHH: pedir una licencia para el legajo 1 de ejemplo
POST {{api}}/api/v1/rrhh/empleados/0192f000-0000-7000-8000-0000000000e1/licencias
Content-Type: application/json
X-Empresa-Id: {{empresa}}
X-Usuario-Sujeto: rrhh.local

{
  "tipo": "EXAMEN",
  "desde": "2026-12-15",
  "hasta": "2026-12-15"
}
